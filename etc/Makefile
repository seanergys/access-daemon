all: ;

install:
	mkdir -p $(PREFIX)
	mkdir -p $(PREFIX)/include/accessd
	mkdir -p $(PREFIX)/lib/accessd/plugins/actuators
	mkdir -p $(PREFIX)/lib/accessd/plugins/metrics
	mkdir -p $(PREFIX)/lib/pkgconfig
	mkdir -p $(PREFIX)/sbin
	cp *.sh $(PREFIX)/sbin

clean: ;

include ../Makefile.exports
